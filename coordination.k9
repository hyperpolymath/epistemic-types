# Thin coordination bindings for central session-management standards
#
# Repo: epistemic-types (hyperpolymath/epistemic-types)
# A small, deliberately honest Agda formalization of standpoint-indexed
# modal / epistemic / echo-like type formers. Single Agda library, no app stack.

session_management:
  source_of_truth: "standards/session-management-standards"
  canonical_commands:
    - "intake repo <path>"
    - "checkpoint change <path>"
    - "verify maintenance <path>"
    - "verify substantial <path>"
    - "verify release <path>"
    - "close planned <path>"
    - "close urgent <path>"
    - "recover repo <path>"
    - "handover full <path>"
    - "handover split <path>"
    - "handover model <path>"
    - "handover human <path>"

signals:
  - name: "session.intake"
    command: "intake repo <path>"
  - name: "session.checkpoint"
    command: "checkpoint change <path>"
  - name: "session.verify.maintenance"
    command: "verify maintenance <path>"
  - name: "session.verify.substantial"
    command: "verify substantial <path>"
  - name: "session.verify.release"
    command: "verify release <path>"
  - name: "session.close.planned"
    command: "close planned <path>"
  - name: "session.close.urgent"
    command: "close urgent <path>"
  - name: "session.recover"
    command: "recover repo <path>"
  - name: "session.handover.full"
    command: "handover full <path>"
  - name: "session.handover.split"
    command: "handover split <path>"
  - name: "session.handover.model"
    command: "handover model <path>"
  - name: "session.handover.human"
    command: "handover human <path>"

# ---------------------------------------------------------------------------
# Repo-local binding. Concrete identifiers for this repository, consumed by the
# session-management signals above. Strictly descriptive of the current tree.
# ---------------------------------------------------------------------------

repo:
  name: "epistemic-types"
  slug: "hyperpolymath/epistemic-types"
  owner: "Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>"
  version: "0.1.0"
  status: "prototype"
  last_updated: "2026-11-01"
  kind: "single-tool Agda library"

# Paths the session machinery must treat as load-bearing. Changes under these
# require a verify pass (build green) before checkpoint/close.
protected_paths:
  - path: "src/"
    role: "Agda sources (the formalization)"
  - path: "src/EpistemicTypes/All.agda"
    role: "full-graph aggregate; recursive gate checks every source file independently"
  - path: ".machine_readable/"
    role: "a2ml + Nickel/k9 machine-readable surface (descriptiles/, proof-transport/)"
  - path: "tests/"
    role: "proof-policy gate, 13 expected rejections and pinned integration witness"
  - path: "PROOF-STATUS.adoc"
    role: "current proof ledger and Mathesis grade boundary"
  - path: "Justfile"
    role: "canonical build recipe"
  - path: "epistemic-types.agda-lib"
    role: "library declaration"

# Invariants every verify/close must uphold. Honesty over API surface.
invariants:
  - id: "build-green"
    statement: "The library typechecks: `just check` succeeds."
    command: "just check"
    expands_to: "bash tests/check-policy.sh && bash tests/check-proofs.sh && bash tests/check-rejections.sh"
    tool: "Agda 2.6.4.3"
  - id: "no-postulates"
    statement: "No postulates or escape hatches. Every first-party module declares --safe --without-K --cubical-compatible --exact-split --no-sized-types --no-guardedness."
  - id: "no-stdlib"
    statement: "Core source has no Agda standard library: --no-libraries with only Agda.Builtin.*, Agda.Primitive and local imports. Pinned CanonicalEcho integration stays separate."
  - id: "licence-owner-manual"
    statement: "Licence/SPDX declarations are present and owner-managed; do not alter them without owner instruction."
  - id: "honesty-over-api"
    statement: "Favour mathematical honesty over a large API. Base E is map-only with no generic bind/extract. Certified Echo C y, separately measured bounds, and E κ A remain distinct; Echo is not a resource instance."

# CI and merge gates are explicitly authorized by the owner (2026-09-07).
ci:
  enabled: true
  note: "Proof and security CI are configured; just check remains the local core gate."

# Real ecosystem siblings this repo coordinates with.
ecosystem:
  siblings:
    - name: "echo-types"
      relationship: "Pinned representation/lowering correspondence only; Echo remains distinct from E κ A and is not a resource instance."
    - name: "ephapax"
      relationship: "Sibling formal language; four-layer redesign carries echo obligations."
    - name: "choreographic-types"
      relationship: "External Warrant consumer with scoped finite binary/plain-merge K-CUT results; no universal theorem imported here."
    - name: "residual-evidence-types"
      relationship: "Production-operated early research with no stable API; local dependence result is a mirror."
    - name: "secret-types"
      relationship: "Standalone production home for confidentiality and generic TINI; no local Secret API or theorem."
    - name: "standards"
      relationship: "Estate RSR/standards + k9-svc + a2ml tooling; source of truth for session-management."
    - name: "a2ml + k9"
      relationship: "Machine-readable + contractile tooling; ProofTransport's engineering target (.machine_readable/proof-transport/)."

# Docs keep their existing names; do not rename or duplicate.
docs:
  - "README.adoc"
  - "explainme.adoc"
