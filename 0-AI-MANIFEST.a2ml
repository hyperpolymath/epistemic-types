[manifest]
name = "0-AI-MANIFEST.a2ml"
title = "epistemic-types — universal AI agent entry point"
version = "0.1.0"
format = "a2ml"
status = "prototype"
last-updated = "2026-11-01"

[project]
name = "epistemic-types"
repo = "hyperpolymath/epistemic-types"
owner = "Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>"
license = "MPL-2.0"
purpose = "A small, deliberately honest Agda formalization of standpoint-indexed modal / epistemic / echo-like type formers. It favours mathematical honesty over a large API."
summary = "Core form E : K -> Set ℓ -> Set ℓ, read 'A is epistemically available at standpoint κ'. The base interface is a plain indexed endofunctor (map only) — NOT a monad/comonad; there is no generic return/reflect."

[canonical-locations]
machine-readable = ".machine_readable/"
state = ".machine_readable/descriptiles/STATE.a2ml"
meta = ".machine_readable/descriptiles/META.a2ml"
ecosystem = ".machine_readable/descriptiles/ECOSYSTEM.a2ml"
agentic = ".machine_readable/descriptiles/AGENTIC.a2ml"
neurosym = ".machine_readable/descriptiles/NEUROSYM.a2ml"
playbook = ".machine_readable/descriptiles/PLAYBOOK.a2ml"
proof-transport-spec = ".machine_readable/proof-transport/ProofTransport.a2ml"
proof-transport-contractile = ".machine_readable/proof-transport/proof-transport.k9.ncl"
proof-transport-readme = ".machine_readable/proof-transport/README.adoc"

[docs]
readme = "README.adoc"
explainme = "explainme.adoc"
audit = "AUDIT.adoc"
format = "AsciiDoc (.adoc) is the default. README.adoc is the overview, explainme.adoc the concise narrative, and EXPLAINME.adoc the detailed claim/evidence ledger; treat their exact casing as canonical."

[invariants]
machine-readable-location = "Project specifications live under .machine_readable/. The root 0-AI-MANIFEST.a2ml universal pointer and coordination.k9 session entry point are the explicit operational exceptions."
license = "MPL-2.0"
build = "just check"
build-expansion = "bash scripts/check.sh → policy gate + all 22 source modules + all 13 expected rejections"
agda-options = "--safe --without-K --cubical-compatible plus source hardening --exact-split --no-sized-types --no-guardedness; -W error with UnsupportedIndexedMatch disabled only alongside an exact 23-source-span audit; no postulates; core imports only builtins/primitive/local modules"
agda-version = "2.6.4.3"
echo-distinction = "Do not collapse Echo C y and E κ A. Echo retains certified residues; epistemic types are standpoint/warrant/access modalities. Their composition is meaningful; they are not the same modality."
ci = "Proof and security workflows configured; required merge checks are described in docs/ci-safety.adoc"
proof-status = "AGDA-VERIFIED; Mathesis Grade 3. Canonical Proof Safety receipt 41326349568 at checked revision bf9c75a38794d744ce466574e6323062e7d22533. Independent Rocq/Lean/bridge legs remain open."
secret-types = "Owner decision 2026-10-04: hyperpolymath/secret-types is the standalone production home (D153/D154). Do not add a Secret API, IFC implementation or confidentiality theorem here. #29 stays closed; #32 closed on 2026-10-05 with no transfer and must not be reopened/duplicated (guard #39). Source-reviewed at standalone f581f8295bdee854f76291ab884a16cc8114dc6f on 2026-11-01: generic TINI and its two-point instance are PROVEN; termination-sensitive noninterference and declassification remain OPEN. No theorem is imported here."

[first-run]
dev-container = ".devcontainer/ — Debian 13 pinned to the same base image digest as CI, agda-bin=2.6.4.3-1+b2; postCreateCommand runs 'just check'."
local = "just check → scripts/check.sh: local Agda when present, otherwise 'guix shell -D -f build/guix.scm -- bash scripts/check.sh'."
ci = ".github/workflows/agda.yml asserts 'Agda version 2.6.4.3' and runs 'bash scripts/check.sh' in the pinned Debian 13 container."

[source]
root = "src/EpistemicTypes/"
aggregator = "src/EpistemicTypes/All.agda"
modules = [
  "EpistemicTypes.Access",
  "EpistemicTypes.All",
  "EpistemicTypes.Applications.IntegerModel",
  "EpistemicTypes.Applications.OrderedGroup",
  "EpistemicTypes.Applications.QCriterion",
  "EpistemicTypes.Applications.RapidNJExamples",
  "EpistemicTypes.Applications.RapidNJSkip",
  "EpistemicTypes.Applications.SortedRow",
  "EpistemicTypes.Base",
  "EpistemicTypes.ContinuityExamples",
  "EpistemicTypes.EchoBridge",
  "EpistemicTypes.Examples",
  "EpistemicTypes.Kripke.Belief",
  "EpistemicTypes.Kripke.Dependence",
  "EpistemicTypes.Kripke.Frame",
  "EpistemicTypes.Kripke.Indexed",
  "EpistemicTypes.Kripke.Residual",
  "EpistemicTypes.ProofTransport",
  "EpistemicTypes.ProofTransportExample",
  "EpistemicTypes.ReadConsistency",
  "EpistemicTypes.SurrealBridge",
  "EpistemicTypes.Warrant",
]

[source.descriptions]
Base = "Modality / LawfulModality / FactiveModality / BeliefModality / ReturnModality. The base E is a plain indexed endofunctor (map only)."
Warrant = "Warrant / Epi / SoundWarrant — explicit warrant objects."
Access = "Preorder plus AccessibleModality transport ('increase') across the access preorder."
EchoBridge = "Certified Echo C y residues, explicit migration/recovery and separately measured resource bounds."
SurrealBridge = "SurrealAccess carrier plus GradedSurrealModality plus daySurrealAccess finite-birthday tower."
Examples = "Worked instances of the abstract interfaces."
ProofTransport = "Standpoint-indexed proof transport across trust boundaries."
ProofTransportExample = "Sound Boolean certificate checks; valid acceptance, bad payload/artefact rejection, false-claim and holder-boundary impossibility."
Applications = "Six-module RapidNJ Q-criterion/skip-warrant layer with discharged integer instance and explicit rational/update obligations."
Kripke = "Five-module scoped constructive semantics: indexed Box/frame correspondences, non-factive model, residual candidates and dependence mirror."
ReadConsistency = "Pure store histories, current reads, cache staleness and explicit fact stability."

[proof-transport]
thesis = "Proofhood is standpoint-indexed. Transmission across a trust boundary moves bytes (von Neumann), not proofhood (Curry-Howard); a receiver recovers proofhood only with its OWN checker plus evidence."
view = "View : Agent -> Artifact -> Status -> Claim -> Set"
statuses = [ "Data", "Code", "Claimed", "Receipt", "Proof", "ProofUnder" ]
modes = [ "Public", "Designated", "IssuerMediated", "EnvironmentMediated", "OpaqueReceipt" ]
transmit = "downgrades a sender's Proof to a receiver's Receipt"
verify = "evaluates the receiver's sound check; acceptance yields Proof, rejection yields InvalidEvidence"
laws = [
  "public transport requires an explicit implication between holder meanings",
  "designated is receiver-bound",
  "receipt-only never certifies",
  "proofNeedsChecker = weaker structural projection; proofSound entails Meaning holder a c",
]
authority = "The Agda module src/EpistemicTypes/ProofTransport.agda is authoritative; the .machine_readable/proof-transport/ rendering mirrors it for a2ml/k9 tooling."

[session-startup]
step-1 = "Read this manifest (0-AI-MANIFEST.a2ml)."
step-2 = "Read .machine_readable/descriptiles/STATE.a2ml for current project state, module list, and roadmap."
step-3 = "Read .machine_readable/descriptiles/META.a2ml for architecture and design decisions."
step-4 = "Read .machine_readable/descriptiles/ECOSYSTEM.a2ml for ecosystem position and sibling repos."
step-5 = "Read .machine_readable/descriptiles/AGENTIC.a2ml, NEUROSYM.a2ml, and PLAYBOOK.a2ml for agent guidance."
step-6 = "Read README.adoc and explainme.adoc for the human-facing overview."
step-7 = "Run 'just check' (→ scripts/check.sh: local Agda or Guix/dev container) to enforce policy, check all 22 source modules and validate all 13 expected rejections before and after changes."

[policy]
rules = [
  "Preserve mathematical honesty: do not introduce postulates; laws appear as fields when not derivable.",
  "Keep core source dependency-free: no Agda standard library; only Agda.Builtin.*, Agda.Primitive and local modules. Keep the optional canonical integration pinned and separate.",
  "Keep modules small and type-check frequently with 'just check'.",
  "Keep project a2ml/Nickel/k9 specifications under .machine_readable/; retain only the universal 0-AI-MANIFEST.a2ml pointer and coordination.k9 session entry point at the root.",
  "License and SPDX changes are owner-manual; do not add LICENSE files or SPDX headers.",
  "Maintain owner-authorized proof and security CI; do not bypass failing checks.",
  "Secret types and information-flow control stay outside this repository (D153/D154; canonical specification in hyperpolymath/secret-types). Issue #32 is closed (2026-10-05, delivered here; no transfer): do not reopen, transfer, or duplicate it, and use the successor guard #39 for pointer updates (docs/secret-types.adoc section Status update 2026-10-25).",
]

[ecosystem]
siblings = [
  { name = "echo-types", relation = "Canonical proof-relevant Echo sibling; optional pin checks representation and one-way lowering. Echo is not a resource instance." },
  { name = "ephapax", relation = "Sibling formal language; four-layer redesign with echo obligations." },
  { name = "choreographic-types", relation = "External Warrant consumer with scoped K-CUT proofs; not a local proof import." },
  { name = "residual-evidence-types", relation = "Production-operated early research with no stable API; local mirror only." },
  { name = "secret-types", relation = "Standalone production confidentiality/TINI project; no local Secret API." },
  { name = "standards", relation = "Estate RSR/standards plus k9-svc and a2ml tooling." },
  { name = "a2ml", relation = "Machine-readable dialect; ProofTransport's engineering rendering target." },
  { name = "k9", relation = "Contractile tooling; proof-transport.k9.ncl is a Kennel-leash datum for it." },
]

[languages]
source = "Agda"
machine-readable = "a2ml + Nickel/k9"
docs = "AsciiDoc"
