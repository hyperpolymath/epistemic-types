# PLAYBOOK.a2ml — Operational playbook
# Runbook for epistemic-types: a single-tool Agda library checked by `just check`.
# Concise and specific to this repo. There is no service to deploy; CI verifies the proof and security contracts.

[metadata]
version = "0.1.0"
status = "prototype"
last-updated = "2026-11-01"
repo = "hyperpolymath/epistemic-types"
single-tool = "agda"

[deployment]
method = "library (no deploy)"
target = "library"
notes = "Constructive Agda formalization consumed by reading and re-checking the source. Nothing is built into an artifact, served, or shipped. Downstream use = import the modules and typecheck."
ci = "Proof and security CI enabled; see docs/ci-safety.adoc"

[gate]
# The single source of truth for 'is the library healthy?'.
command = "just check"
expands-to = "tests/check-policy.sh; tests/check-proofs.sh over all 22 source modules; tests/check-rejections.sh over all 13 fixtures"
agda-version = "2.6.4.3"
options = "--safe --without-K --cubical-compatible; source hardening --exact-split --no-sized-types --no-guardedness"
dependencies = "core: Agda builtins/primitive and local modules only; optional canonical integration pins Echo source and stdlib"
green-means = "Policy guard passes, every source module checks, and every enumerated malformed construction fails for its intended reason."

[incident-response]
# 'Incident' here = the library stopped typechecking.
steps = [
  "1. Read .machine_readable/descriptiles/STATE.a2ml for current status, assumptions, and the module list.",
  "2. Run `just check` to reproduce the same policy, positive-proof and expected-rejection gates as core CI.",
  "3. Identify whether the policy inventory, a positive module, or an intended rejection failed; missing tools/imports are failures, not evidence.",
  "4. Fix the source or status record without weakening flags, widening the map-only API, or turning an assumption into a theorem.",
  "5. Re-run `just check` until all three gates are green; update PROOF-STATUS.adoc when proof scope changes."
]
honesty-rule = "Never silence a failure with a postulate or by weakening --safe/--without-K/--cubical-compatible. Laws appear as explicit fields when they are not derivable."
boundary-rule = "Do not collapse Echo C y (certified residue and separately measured bounds) into E κ A (standpoint/warrant/access). Their composition is meaningful; they are not the same modality."

[release-process]
steps = [
  "1. Bump version in .machine_readable/descriptiles/STATE.a2ml and META.a2ml.",
  "2. Run `just check` and confirm it is green.",
  "3. Update CHANGELOG.adoc with the changes for this version.",
  "4. Tag the release at the green commit."
]
preconditions = "`just check` and the pinned integration gate are green at the release revision; no postulates; canonical strict profile still holds."

[maintenance-operations]
gate = "`just check`"
description = "`just check` is the maintenance gate. Any change to src/EpistemicTypes/** is only complete once `just check` is green again."
routine = [
  "After editing any module, run `just check`.",
  "When adding a module, update the source graph, policy inventory, STATE module list and current counts; recursive checking does not depend on public re-export.",
  "Keep modules small and typecheck frequently (incremental, one module at a time).",
  "Keep PROOF-STATUS and PROOF-NEEDS aligned with exact theorem scope and external trust boundaries."
]
no-runtime = "There is no deployed service. Proof, rejection, policy, canonical correspondence, governance, CodeQL and secret-scanning gates are separate and must not be conflated."

[ecosystem]
# Sibling repos this library relates to (no automated coupling).
echo-types = "Agda loss-with-residue formalism; EpistemicTypes.EchoBridge composes with it."
ephapax = "Sibling formal language (four-layer redesign with echo obligations)."
standards = "Estate RSR/standards, k9-svc, and a2ml tooling."
a2ml-k9 = "Machine-readable + contractile tooling; the engineering target rendered under .machine_readable/proof-transport/ for ProofTransport."
