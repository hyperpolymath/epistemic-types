[metadata]
project = "epistemic-types"
version = "0.1.0"
last-updated = "2026-09-27"
status = "prototype"  # prototype | active | paused | archived

[project-context]
name = "epistemic-types"
owner = "Jonathan D.A. Jewell (hyperpolymath)"
repo = "hyperpolymath/epistemic-types"
purpose = "A small, deliberately honest Agda formalization of standpoint-indexed modal / epistemic / echo-like type formers. Favours mathematical honesty over a large API: the base interface E : K -> Set ℓ -> Set ℓ is a plain indexed endofunctor (map only), NOT a monad/comonad — no generic return/reflect."
completion-percentage = 35

[position]
phase = "design"           # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[constraints]
discipline = "Constructive. Compiles under {-# OPTIONS --safe --without-K #-}. No postulates. No Agda standard library (built with 'agda --no-libraries'; only Agda.Builtin.* / Agda.Primitive)."
honesty-rule = "Laws appear as explicit fields when not derivable; lawful instances are added only after proving or explicitly assuming the laws. No smuggling."

[build]
checker = "Agda 2.6.4.3"
command = "just check"
expands-to = "bash tests/check-proofs.sh && bash tests/check-rejections.sh"
aggregator = "src/EpistemicTypes/All.agda re-exports every module."

[modules]
# Agda modules under src/EpistemicTypes/.
list = [
  "EpistemicTypes.Access",
  "EpistemicTypes.Applications.IntegerModel",
  "EpistemicTypes.Applications.OrderedGroup",
  "EpistemicTypes.Applications.QCriterion",
  "EpistemicTypes.Applications.RapidNJExamples",
  "EpistemicTypes.Applications.RapidNJSkip",
  "EpistemicTypes.Applications.SortedRow",
  "EpistemicTypes.All",
  "EpistemicTypes.Base",
  "EpistemicTypes.ContinuityExamples",
  "EpistemicTypes.EchoBridge",
  "EpistemicTypes.Examples",
  "EpistemicTypes.ProofTransport",
  "EpistemicTypes.ProofTransportExample",
  "EpistemicTypes.ReadConsistency",
  "EpistemicTypes.SurrealBridge",
  "EpistemicTypes.Warrant",
]

[modules.detail]
base = "Modality / LawfulModality / FactiveModality / BeliefModality / ReturnModality. The base form E κ A reads 'A is epistemically available at standpoint κ'."
warrant = "Warrant / Epi / SoundWarrant."
access = "Preorder + AccessibleModality transport 'increase'."
echo-bridge = "Certified residue Echo C y, explicit source compatibility, recovery/migration laws and measured resource bounds; distinct from E κ A."
surreal-bridge = "SurrealAccess carrier + GradedSurrealModality + daySurrealAccess finite birthday tower."
examples = "Worked instances exercising the interfaces."
proof-transport = "proofSound derives Meaning holder artifact claim from an accepted sound checker. Receipts alone do not certify; transfer requires the target-holder meaning."
proof-transport-example = "Boolean certificate checker with legitimate acceptance and refutations for false claims, changed artifacts and holder-sensitive replay."
applications-ordered-group = "Minimal arithmetic budget for the applications layer: carrier with addition, negation, zero, order, reflexivity, transitivity, joint monotonicity and antitone negation; derived subtraction and Nat-indexed scaling."
applications-integer-model = "The integers as difference pairs over Nat, with the cross-multiplied order, all four OrderedGroup laws, the instance 'ℤ-group', and a decision procedure for the order."
applications-sorted-row = "Rows as entries (index, distance, row sum), the All predicate, membership, the sorted-row and running-maximum invariants, and prefix/suffix composition."
applications-qcriterion = "Q and qBound over any OrderedGroup, the bound lemma qBound-≤-Q, the row lemma qBound-≤-suffix, claim weakening, and prefix/suffix composition."
applications-rapidnj-skip = "Checkable (the exactness seam), scan state, skip evidence, the generated warrant and soundness map, the factive modality, the belief-only reading, and the declared-not-assumed cross-iteration obligation."
applications-rapidnj-examples = "Executable integer check, refutation of an over-eager comparison, a worked four-taxon scan, and the runtime status mirror (Factive / Belief / Collapsed / SansFibre)."

[route-to-mvp]
milestones = [
  { name = "Base indexed-endofunctor interface (E, Modality and law-fields)", completion = 100 },
  { name = "Warrant / Access / EchoBridge / SurrealBridge formers", completion = 100 },
  { name = "ProofTransport core (View, statuses, modes, transmit/verify)", completion = 100 },
  { name = "Concrete Kripke-style semantics", completion = 0 },
  { name = "Evidence-state and observation-rule examples", completion = 0 },
  { name = "Richer day-bounded surreal fragments as SurrealAccess instances", completion = 0 },
  { name = "Applications layer: RapidNJ Q-criterion bound and skip warrants", completion = 100 },
  { name = "Rational (ℚ) instance and the common-denominator rescaling transport", completion = 0 },
  { name = "Lawful instances (only after proving or explicitly assuming laws)", completion = 0 },
]

[roadmap]
items = [
  "Add concrete Kripke-style semantics.",
  "Add evidence-state and observation-rule examples.",
  "Add richer day-bounded surreal fragments as instances of the abstract SurrealAccess interface.",
  "Add lawful instances only after proving or explicitly assuming laws.",
  "Extend the echo bridge without importing a full graded comonad.",
  "Add a rational carrier instance for the applications layer, or prove the common-denominator rescaling transport.",
  "Model the row-insertion update that maintains the scan invariants, and cross-iteration bound reuse.",
]

[progress-summary]
note = "Prototype. The base interface and all seventeen modules typecheck under 'just check' (Agda 2.6.4.3, --safe --without-K, --no-libraries, no postulates), against twelve rejection fixtures. The endofunctor/Modality formers, Warrant, Access transport, EchoBridge residue, SurrealBridge tower, ProofTransport, its K9-SVC/A2ML attestation example, and the applications layer (RapidNJ Q-criterion bound, generated skip warrants, discharged integer instance) are in place. Remaining work is semantics, lawful instances, and the rational/rescaling obligation — see [roadmap]."

[blockers-and-issues]
# No active blockers.

[critical-next-actions]
actions = [
  "Add concrete Kripke-style semantics for the standpoint-indexed formers.",
  "Add evidence-state and observation-rule worked examples.",
  "Prove or explicitly assume modality laws before exposing lawful instances.",
  "Extend the echo bridge without importing a full graded comonad.",
]

[ci]
enabled = true
note = "Proof and security CI are configured; see docs/ci-safety.adoc for merge requirements."

[ecosystem]
part-of = ["RSR Framework", "echo / epistemic formal-methods siblings"]
siblings = [
  { name = "echo-types", relation = "Agda loss-with-residue formalism; EchoBridge composes with it." },
  { name = "ephapax", relation = "Sibling formal language; four-layer redesign carries echo obligations." },
  { name = "standards", relation = "Estate RSR/standards + k9-svc + a2ml tooling." },
  { name = "a2ml + k9", relation = "Machine-readable + contractile tooling; the engineering target for ProofTransport (see .machine_readable/proof-transport/)." },
]
