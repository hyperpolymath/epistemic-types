[metadata]
project = "epistemic-types"
version = "0.1.0"
last-updated = "2026-11-07"
status = "prototype"  # prototype | active | paused | archived

[project-context]
name = "epistemic-types"
owner = "Jonathan D.A. Jewell (hyperpolymath)"
repo = "hyperpolymath/epistemic-types"
purpose = "A small, deliberately honest Agda formalization of standpoint-indexed modal / epistemic / echo-like type formers. Favours mathematical honesty over a large API: the base interface E : K -> Set ℓ -> Set ℓ is a plain indexed endofunctor (map only), NOT a monad/comonad — no generic return/reflect."
completion-percentage = 35

[position]
phase = "design"           # design | implementation | testing | maintenance | archived
maturity = "experimental"  # experimental | alpha | beta | production | lts

[constraints]
discipline = "Constructive. Every first-party module declares --safe --without-K --cubical-compatible --exact-split --no-sized-types --no-guardedness. No postulates or proof escape hatches. Core source uses no Agda standard library (agda --no-libraries; only Agda.Builtin.*, Agda.Primitive and local modules)."
honesty-rule = "Laws appear as explicit fields when not derivable; lawful instances are added only after proving or explicitly assuming the laws. No smuggling."

[boundaries]
secret-types = "Owner decision 2026-10-04: hyperpolymath/secret-types is the standalone production home for secret types (D153/D154). This repository adds no Secret API, IFC implementation or confidentiality theorem; docs/secret-types.adoc is the boundary/history note. epistemic-types#29 stays closed; #32 was closed on 2026-10-05 as delivered here with no transfer; do not reopen/duplicate it (successor guard #39). Source-reviewed at secret-types f581f8295bdee854f76291ab884a16cc8114dc6f on 2026-11-01: generic TINI over a Lattice record/down-closed observers and the two-point instance are PROVEN in its ledger; termination-sensitive noninterference and declassification remain OPEN. No theorem is imported here."

[build]
checker = "Agda 2.6.4.3 (CI-matched)"
command = "just check"
entry-point = "scripts/check.sh — local agda when present, else 'guix shell -D -f build/guix.scm -- bash scripts/check.sh'"
expands-to = "bash tests/check-policy.sh && bash tests/check-proofs.sh && bash tests/check-rejections.sh && bash tests/check-approval-seal-mutations.sh"
dev-container = ".devcontainer/ — Debian 13 pinned to the same base image digest as CI, agda-bin=2.6.4.3-1+b2; postCreateCommand runs 'just check'"
ci-entry-point = ".github/workflows/agda.yml asserts 'Agda version 2.6.4.3', then runs 'bash scripts/check.sh'"
warning-policy = "-W error with only noUnsupportedIndexedMatch disabled: locally for Kripke.Belief's indexed relation elimination and at the pinned external integration boundary. No Cubical transport computation is claimed for those functions."
proof-status = "AGDA-VERIFIED; historical hosted receipt below, new local partial-recovery receipt in docs/partial-recovery.adoc. Proof Safety run 41326349568 passed both core/rejection/policy and pinned integration jobs at checked revision bf9c75a38794d744ce466574e6323062e7d22533. Rocq/Lean/bridge legs remain open."
aggregator = "src/EpistemicTypes/All.agda imports the full source graph; the recursive gate separately checks every source file, including modules not publicly re-exported."

[modules]
# Agda modules under src/EpistemicTypes/.
list = [
  "EpistemicTypes.Access",
  "EpistemicTypes.Applications.ApprovalSeal",
  "EpistemicTypes.Applications.IntegerModel",
  "EpistemicTypes.Applications.OrderedGroup",
  "EpistemicTypes.Applications.QCriterion",
  "EpistemicTypes.Applications.RapidNJExamples",
  "EpistemicTypes.Applications.RapidNJSkip",
  "EpistemicTypes.Applications.SortedRow",
  "EpistemicTypes.All",
  "EpistemicTypes.Base",
  "EpistemicTypes.ContinuityExamples",
  "EpistemicTypes.EchoBridge",
  "EpistemicTypes.Examples",
  "EpistemicTypes.Kripke.Belief",
  "EpistemicTypes.Kripke.Dependence",
  "EpistemicTypes.Kripke.Frame",
  "EpistemicTypes.Kripke.Indexed",
  "EpistemicTypes.Kripke.Residual",
  "EpistemicTypes.PartialRecovery",
  "EpistemicTypes.PartialRecoveryExamples",
  "EpistemicTypes.ProofTransport",
  "EpistemicTypes.ProofTransportExample",
  "EpistemicTypes.ReadConsistency",
  "EpistemicTypes.SurrealBridge",
  "EpistemicTypes.Warrant",
]

[modules.detail]
base = "Modality / LawfulModality / FactiveModality / BeliefModality / ReturnModality. The base form E κ A reads 'A is epistemically available at standpoint κ'."
warrant = "Warrant / Epi / SoundWarrant."
access = "Preorder + AccessibleModality transport 'increase'."
echo-bridge = "Certified residue Echo C y, explicit source compatibility, recovery/migration laws and measured resource bounds; distinct from E κ A."
partial-recovery = "Pair-only partial recovery; success soundness is separate. Sound partial recovery and separation plus explicit image decision construct each other. A chosen source fallback totalizes partial recovery; empty/collision/off-image controls and actual canonical Echo-fibre adapter are checked. See docs/partial-recovery.adoc for local receipt and sibling proposals."
surreal-bridge = "SurrealAccess carrier + GradedSurrealModality + daySurrealAccess finite birthday tower."
examples = "Worked instances exercising the interfaces."
proof-transport = "proofSound derives Meaning holder artifact claim from an accepted sound checker. Receipts alone do not certify; transfer requires the target-holder meaning."
proof-transport-example = "Boolean certificate checker with legitimate acceptance and refutations for false claims, changed artifacts and holder-sensitive replay."
applications-ordered-group = "Minimal arithmetic budget for the applications layer: carrier with addition, negation, zero, order, reflexivity, transitivity, joint monotonicity and antitone negation; derived subtraction and Nat-indexed scaling."
applications-integer-model = "The integers as difference pairs over Nat, with the cross-multiplied order, all four OrderedGroup laws, the instance 'ℤ-group', and a decision procedure for the order."
applications-sorted-row = "Rows as entries (index, distance, row sum), the All predicate, membership, the sorted-row and running-maximum invariants, and prefix/suffix composition."
applications-qcriterion = "Q and qBound over any OrderedGroup, the bound lemma qBound-≤-Q, the row lemma qBound-≤-suffix, claim weakening, and prefix/suffix composition."
applications-rapidnj-skip = "Checkable (the exactness seam), scan state, skip evidence, the generated warrant and soundness map, the factive modality, the belief-only reading, and the declared-not-assumed cross-iteration obligation."
applications-rapidnj-examples = "Executable integer check, refutation of an over-eager comparison, a worked four-taxon scan, and the runtime status mirror (Factive / Belief / Collapsed / SansFibre)."
kripke-indexed = "World-indexed modality/factivity/access records and the one-world reduction to the base Modality."
kripke-frame = "Frame and Box; constructive reflexive iff T, transitive iff 4, Euclidean implies 5, serial implies D. Converse 5/D are not claimed."
kripke-belief = "Two-world non-reflexive model with a warrant for a proposition false at the current world and a proof that no soundness map exists for that evidence."
kripke-residual = "Residual candidates as a Box and a three-world presence-without-identification witness."
kripke-dependence = "Local faithful mirror showing candidate-equivalent contexts can differ in proper dependence; identity with residual-evidence-types' owning record remains unproved."

[route-to-mvp]
milestones = [
  { name = "Base indexed-endofunctor interface (E, Modality and law-fields)", completion = 100 },
  { name = "Warrant / Access / EchoBridge / SurrealBridge formers", completion = 100 },
  { name = "ProofTransport core (View, statuses, modes, transmit/verify)", completion = 100 },
  { name = "Scoped constructive Kripke semantics and frame correspondences", completion = 100 },
  { name = "Residual-candidate and presence-without-identification examples", completion = 100 },
  { name = "Richer day-bounded surreal fragments as SurrealAccess instances", completion = 0 },
  { name = "Applications layer: RapidNJ Q-criterion bound and skip warrants", completion = 100 },
  { name = "Rational (ℚ) instance and the common-denominator rescaling transport", completion = 0 },
  { name = "Lawful instances (only after proving or explicitly assuming laws)", completion = 0 },
]

[roadmap]
items = [
  "Extend the scoped Kripke fragment only with exact theorem statements; converse 5/D require explicit classical assumptions.",
  "Re-prove the dependence mirror against residual-evidence-types' owning record before claiming correspondence.",
  "Add richer day-bounded surreal fragments as instances of the abstract SurrealAccess interface.",
  "Add lawful instances only after proving or explicitly assuming laws.",
  "Extend the echo bridge without importing a full graded comonad.",
  "Add a rational carrier instance for the applications layer, or prove the common-denominator rescaling transport.",
  "Model the row-insertion update that maintains the scan invariants, and cross-iteration bound reuse.",
]

[progress-summary]
note = "Prototype. Authoritative inventory: 25 source modules and 19 expected-rejection fixtures. The map-only core, explicit warrant/factivity boundary, proof transport, store consistency, certified Echo residue with separate measured bounds, finite-day surreal adapter, RapidNJ integer certificate, and scoped constructive Kripke semantics are implemented. The 2026-11-01 canonical profile is --safe --without-K --cubical-compatible; hosted/local receipts and the proof-weight grading boundary are in PROOF-STATUS.adoc. Open work includes data-dependent warrant soundness, residual owning-record correspondence, lawful instances, rational/rescaling and update obligations, independent Rocq/Lean legs, and runtime refinement."

[blockers-and-issues]
# No active blockers.

[critical-next-actions]
actions = [
  "Obtain and record the hosted Agda receipt for the explicit 2026-11-01 canonical profile.",
  "Inventory exact propositions before any Rocq/Lean recheck; do not infer correspondence from names.",
  "Prove or explicitly assume modality laws before exposing lawful instances.",
  "Discharge data-dependent warrant, rational/rescaling, row-update, and cross-iteration obligations without widening the base API.",
]

[ci]
enabled = true
note = "Proof and security CI are configured; see docs/ci-safety.adoc for merge requirements."

[ecosystem]
part-of = ["RSR Framework", "echo / epistemic formal-methods siblings"]
siblings = [
  { name = "echo-types", relation = "Agda loss-with-residue formalism; EchoBridge composes with it." },
  { name = "ephapax", relation = "Sibling formal language; four-layer redesign carries echo obligations." },
  { name = "choreographic-types", relation = "External consumer of Warrant with scoped K-CUT proofs; no universal/local proof import." },
  { name = "residual-evidence-types", relation = "Production-operated early research neighbour with no stable API; local dependence mirror only." },
  { name = "secret-types", relation = "Standalone production home for confidentiality/TINI; no local Secret API or theorem." },
  { name = "standards", relation = "Estate RSR/standards + k9-svc + a2ml tooling." },
  { name = "a2ml + k9", relation = "Machine-readable + contractile tooling; the engineering target for ProofTransport (see .machine_readable/proof-transport/)." },
]
