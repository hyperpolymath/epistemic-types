# NEUROSYM.a2ml — Neurosymbolic integration metadata
# Hypatia scanning boundary plus repository-owned Agda policy rules.
# Hypatia's active rule engine is Elixir under its lib/rules/ tree. This
# repository does not vendor those rules and does not claim an enabled Hypatia
# scan; its blocking proof authority remains Agda via scripts/check.sh.

[metadata]
project = "epistemic-types"
version = "0.1.0"
status = "prototype"
last-updated = "2026-11-01"
author = "Jonathan D.A. Jewell (hyperpolymath) <j.d.a.jewell@open.ac.uk>"

[hypatia-config]
scan-enabled = false
scan-depth = "standard"  # quick | standard | deep
report-format = "json"   # Hypatia CLI/AssailReport exchange format
rule-engine = "Hypatia Elixir rules (upstream lib/rules); no rules vendored here"
scan-paths = [ "src/EpistemicTypes" ]
file-globs = [ "*.agda" ]

[symbolic-rules]
# Repository-local syntactic guards. These are input policy for an optional
# Hypatia scan; tests/check-policy.sh and the Agda kernel are authoritative.
rules = [
  { name = "no-postulate", pattern = "postulate", severity = "critical", note = "Positive proof sources postulate nothing. Laws must be fields or proofs." },
  { name = "no-terminating-pragma", pattern = "\\{-# TERMINATING #-\\}", severity = "critical", note = "Termination-checker bypass; forbidden." },
  { name = "no-non-terminating-pragma", pattern = "\\{-# NON_TERMINATING #-\\}", severity = "critical", note = "Termination-checker bypass; forbidden." },
  { name = "no-primTrustMe", pattern = "primTrustMe", severity = "critical", note = "Unsound equality witness; forbidden." },
  { name = "no-trustMe", pattern = "trustMe", severity = "critical", note = "Library wrapper over primTrustMe; forbidden." },
  { name = "no-no-positivity-check", pattern = "\\{-# NO_POSITIVITY_CHECK #-\\}", severity = "critical", note = "Positivity-checker bypass; forbidden." },
  { name = "no-no-termination-check", pattern = "\\{-# NO_TERMINATION_CHECK #-\\}", severity = "critical", note = "Legacy termination-checker bypass; forbidden." },
  { name = "no-stdlib-import", pattern = "open import (Data|Relation|Function|Algebra|Category|Codata|Effect|Foreign|IO|Reflection|Tactic|Agda\\.Builtin\\.Reflection)\\b", severity = "high", note = "Core source is checked with --no-libraries; only Agda builtins/primitive and local modules are permitted." },
  { name = "no-unsafe-options", pattern = "\\{-# OPTIONS[^#]*--type-in-type", severity = "critical", note = "The source profile is --safe --without-K --cubical-compatible; type-in-type is forbidden." },
  { name = "echo-not-collapsed", pattern = "Echo .* = .* E ", severity = "medium", note = "Heuristic manual-review hit: Echo residue, measured resource bounds, and epistemic availability are distinct." }
]

[symbolic-rules.notes]
checker-of-record = "bash scripts/check.sh"
canonical-agda-profile = "--safe --without-K --cubical-compatible"
source-hardening = "--exact-split --no-sized-types --no-guardedness"
trust-boundary = "Hypatia findings are advisory here. Agda proof gates and exact expected-rejection diagnostics block proof regressions."

[neural-config]
enabled = false
note = "No learned pattern model is configured for this formal library."

[ci]
hypatia-scan-enabled = false
proof-ci-enabled = true
proof-entry-point = "bash scripts/check.sh"
note = "Proof, rejection, canonical Echo, governance, CodeQL and secret-scanning workflows exist; see docs/ci-safety.adoc. No Hypatia scan result is claimed."
